GEMINI_API_KEY="your-gemini-api-key"
ANTHROPIC_API_KEY="your-anthropic-claude-api-key"

DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

JWT_SECRET_KEY="your-secret-key-min-32-chars"
# JWT_ALGORITHM defaults to HS256 if not set
# FRONTEND_ORIGIN defaults to http://localhost:5173 — set to https:// URL in production to enable secure cookies

# Set to "true" to skip real LLM calls and return a static streamed response.
# Useful for testing the frontend streaming UI without incurring API costs.
DEV_MOCK=false
